# ─── TravelOS production environment ───────────────────────────────
# Copy to `.env` at the repo root on your VPS and fill in real values.
# Do NOT commit the real .env file.

# PostgreSQL connection string (created in step 4 of deploy/README.md)
DATABASE_URL=postgresql://travelos:CHANGE_ME@127.0.0.1:5432/travelos

# Secret used to sign auth tokens / sessions. Generate a long random value:
#   openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Port the API server listens on (nginx proxies to this). 8080 is standard.
PORT=8080

# Always "production" on the VPS.
NODE_ENV=production

# Your public domains, comma-separated. Used only to build absolute callback
# URLs for FASTag / GPS webhooks. Safe to set to your primary domain.
REPLIT_DOMAINS=www.kyro360.in

# ─── Object storage (admin image uploads) ─────────────────────────
# Choose ONE backend.
#
# (A) LOCAL DISK — recommended for self-hosting. Uploads are stored on the
#     VPS filesystem and served by the API. No external service needed.
STORAGE_BACKEND=local
# Where uploaded files live. Must be writable by the API's user (www-data).
# Defaults to <repo>/storage-data if unset. Back this directory up.
LOCAL_STORAGE_DIR=/var/www/travelos/storage-data
#
# (B) REPLIT / GCS bucket — only works with a Google Cloud Storage bucket and
#     Replit's sidecar credentials. Leave STORAGE_BACKEND unset (or not "local")
#     to use this, and set the two paths below. Not usable on a plain VPS.
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=
